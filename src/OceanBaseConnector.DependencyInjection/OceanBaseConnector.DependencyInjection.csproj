<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>OceanBaseConnector.DependencyInjection</PackageId>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Dependency injection integration for the unified OceanBase ADO.NET provider.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OceanBaseConnector/OceanBaseConnector.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <!-- Require this provider release or newer without an exact-version constraint. -->
  <Target Name="PinCorePackageDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[$(Version),)" />
    </ItemGroup>
  </Target>
</Project>
