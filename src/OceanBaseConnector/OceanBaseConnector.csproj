<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>OceanBaseConnector</RootNamespace>
    <AssemblyName>OceanBaseConnector</AssemblyName>
    <!-- Version comes from Directory.Build.props; never set it here. -->
    <Description>Managed ADO.NET provider for OceanBase (MySQL and Oracle compatibility modes).</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      DbConnectionStringBuilder's indexer annotations are asymmetric on modern
      TFMs (non-nullable getter return, nullable setter value); no single
      override signature satisfies both. See OceanBaseConnectionStringBuilder.
    -->
    <NoWarn>$(NoWarn);CS8764;CS8765</NoWarn>
    <!-- Packaging metadata is finalized at the R01 release gate. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OceanBaseConnector.UnitTests" />
    <InternalsVisibleTo Include="OceanBaseConnector.IntegrationTests" />
    <InternalsVisibleTo Include="OceanBaseConnector.ConsumerTests" />
  </ItemGroup>

</Project>
